<Project Sdk="Microsoft.NET.Sdk">

  <!-- The browser-hook module's own tests (architecture.md Sec 15.1): they
       pin the module's content, the template's render contract and the
       codec's cross-language conformance, and therefore travel with the
       module, not with the kernel's suites. They reference nothing
       in-house: the wire vectors below are baked golden bytes, produced
       once by the .NET encoder and pinned here, so the module stands alone
       exactly the way an external module must, project file included: it
       declares its own target framework and package versions, inheriting
       nothing from the platform repository's build settings. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
